{
  "name": "@samva/better-auth",
  "version": "0.1.1",
  "description": "Better Auth email callbacks powered by Samva.",
  "keywords": [
    "auth",
    "better-auth",
    "email",
    "samva",
    "transactional-email"
  ],
  "homepage": "https://samva.dev",
  "bugs": {
    "url": "https://github.com/SamvaHQ/Samva/issues"
  },
  "license": "MIT",
  "author": "Arya Labs, Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamvaHQ/Samva.git",
    "directory": "packages/better-auth"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "prepack": "bun run build",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@react-email/render": "^2.0.0",
    "better-auth": "^1.7.0-beta.9",
    "samva": "^0.3.0"
  },
  "peerDependencies": {
    "@react-email/render": "^2.0.0",
    "better-auth": "^1.7.0-beta.9",
    "samva": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
